# .env.sample — Kopiervorlage für .env (Verbindungsdaten zum BOKU-Server).
#   cp .env.sample .env   # dann Werte eintragen; .env ist gitignored (mode 600)
export PGHOST=localhost
export PGPORT=5432
export PGDATABASE=clx
export PGUSER=readonly           # read-only Account
export PGPASSWORD=''
export PGSSLMODE=require         # verschlüsselt, ohne Zertifikatsprüfung
export READONLY_DB_PASSWORD="$PGPASSWORD"   # Alias für den R-Code
